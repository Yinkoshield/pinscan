# Build outputs. `make build` writes to bin/; a bare `go build` at the root
# writes ./pinscan. Neither is ever committed: releases are built by goreleaser.
bin/
dist/
/pinscan
/pinscan.exe
coverage.out
.DS_Store

# Android NDK build artifacts (the committed .so is android/ykzpinscan/zygisk/<abi>.so)
android/ykzpinscan/obj/
android/ykzpinscan/libs/
# A user's own research CA dropped into the module (never commit a CA)
android/ykzpinscan/cacerts/*.0

# Validation kit: Gradle outputs of the device-side test app, and the reports
# scripts/validate-device.sh writes (they carry host IPs and CA fingerprints).
android/validation-app/.gradle/
android/validation-app/build/
android/validation-app/app/build/
android/validation-app/local.properties
android/validation-app/.idea/
android/validation-app/gradlew
android/validation-app/gradlew.bat
android/validation-app/gradle/
/validation/
