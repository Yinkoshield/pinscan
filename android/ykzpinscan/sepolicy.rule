# ykzpinscan — SELinux rules so the app-fork (u:r:zygote:s0, pre-specialize) can bind
# the prepared cacerts store over the Conscrypt APEX store at preAppSpecialize.
# Magisk loads this file at boot. post-fs-data.sh additionally applies the same
# rules with `magiskpolicy --live`, because under ZygiskNext a module's
# sepolicy.rule is not always merged into the live policy.
allow zygote system_security_cacerts_file dir { mounton search read open getattr }
allow zygote system_security_cacerts_file file { read open getattr }
allow zygote adb_data_file dir search
allow zygote adb_data_file file { read open getattr }
allow zygote system_file dir search
