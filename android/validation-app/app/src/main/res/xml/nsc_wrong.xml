<?xml version="1.0" encoding="utf-8"?>
<!-- A misconfigured pin set: one pin that matches no key (32 zero bytes). The
     app cannot reach the real host either; it rejects every chain, forged or
     genuine, during the handshake. Regenerated by build.sh (host only). -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="false">example.com</domain>
        <pin-set>
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
